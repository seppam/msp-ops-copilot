# Copy this file to .env and fill in the values in your editor.
# Never paste real keys into chat, commits, or screenshots.

# Which provider the app uses: groq | gemini
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
# Check the model name in Google AI Studio; free-tier models change.
GEMINI_MODEL=gemini-3.5-flash-lite

# Odoo (local docker lab, see ~/Documents/odoo-lab)
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=mspdemo
ODOO_API_KEY=

# Optional, paid per token. Leave empty unless you set a budget first.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
